{
  "name": "h4kuna/workdays",
  "type": "library",
  "homepage": "https://github.com/h4kuna/workdays",
  "keywords": [
    "workdays"
  ],
  "license": [
    "MIT"
  ],
  "authors": [
    {
      "name": "Milan Matějček",
      "email": "milan.matejcek@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "h4kuna/data-type": "^4.0"
  },
  "require-dev": {
    "nette/tester": "^2.5",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "shipmonk/coding-standard": "^0.2",
    "tracy/tracy": "^2.9"
  },
  "autoload": {
    "psr-4": {
      "h4kuna\\Workdays\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "h4kuna\\Workdays\\Tests\\": "tests"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "cbf": "vendor/bin/phpcbf",
    "coverage": "vendor/bin/tester --coverage coverage.html --coverage-src src/ --colors 1 -s -C tests/Unit",
    "cs": "vendor/bin/phpcs",
    "qa": [
      "@tests",
      "@cs",
      "@stan"
    ],
    "stan": "vendor/bin/phpstan analyse",
    "tests": "vendor/bin/tester --colors 1 -s -C tests/Unit"
  }
}
